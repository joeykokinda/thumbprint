{
  "manifest_version": 3,
  "name": "Thumbprint",
  "version": "0.1.0",
  "description": "See which posts were approved on a real device, and get warned when an account that signs its posts publishes one that is not signed.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:8787/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Thumbprint" },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["shared.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
